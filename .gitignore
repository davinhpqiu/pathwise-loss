# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Data and outputs — regenerate, don't commit
data/raw/*
data/synthetic/*
!data/**/.gitkeep
results/runs/*
results/logs/*
!results/**/.gitkeep

# Keep figures that go in the report, ignore scratch ones
results/figures/scratch/

# ARC / SLURM
slurm-*.out
*.err

# OS
.DS_Store

# R
.Rhistory
.RData

# node (scripts/check_math.js)
node_modules/
package-lock.json

# Working notes: kept locally, deliberately untracked (20/08).
# Exception: the pre-registered procedure for experiments A and B is tracked,
# since notebooks 05 and 06 cite it as the design fixed before their results.
docs/*
!docs/neural_ode_operator_experiments.md

# LaTeX build artefacts. Deck source, theme and rendered presentation assets
# are tracked. Regenerate the figures from restored experiment outputs with
# scripts/build_presentation_figures.py.
presentation/*.aux
presentation/*.log
presentation/*.nav
presentation/*.snm
presentation/*.toc
presentation/*.out
presentation/*.fls
presentation/*.fdb_latexmk
presentation/*.synctex.gz
presentation/tmp*.tmp
