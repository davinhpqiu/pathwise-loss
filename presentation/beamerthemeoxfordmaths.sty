%% Mathematical Institute, University of Oxford
%% LaTeX Beamer Presentation Theme
%%
%% v1.0 Original theme: Tim Hosgood 2015
%% v2.0 Reimplementation: Karl Welzel May 2024
%% v2.1 Further adjustments: Keith Gillow May 2024

\useoutertheme{infolines}
\definecolor{oxfordblue}{RGB}{0,33,71}
\usecolortheme[named=oxfordblue]{structure}
\setbeamertemplate{navigation symbols}{}

\newlength{\textmargin}
\setlength{\textmargin}{10mm}
\setbeamersize{text margin left=\textmargin,text margin right=\textmargin}
\newlength{\titlehmargin}
\setlength{\titlehmargin}{5mm}
\newlength{\titlevmargin}
\setlength{\titlevmargin}{1mm}
\newlength{\fullpagewidth}
\setlength{\fullpagewidth}{\dimexpr\textwidth+\textmargin+\textmargin\relax}
\newlength{\oxfordlogowidth}
\setlength{\oxfordlogowidth}{\dimexpr 10mm * 214 / 311 \relax}
\newlength{\mathslogowidth}
\setlength{\mathslogowidth}{\dimexpr 3mm * 347 / 105 \relax}

%% DataSig logo, header only: brand assets carry a light background, so the
%% navy title slide takes the institute line instead. Drop datasig-logo.png into
%% theme-assets/ to switch it on; deck compiles unchanged while file is absent.
%% Width 16mm sets logo height 7.2mm against the 10mm Oxford crest at aspect
%% 561:252, the cropped mark-and-wordmark block.
\newlength{\datasiglogowidth}
\setlength{\datasiglogowidth}{16mm}
\newlength{\datasiglogolift}
\setlength{\datasiglogolift}{1.4mm}
\newcommand{\datasiglogofile}{datasig-logo.png}
\newif\ifdatasiglogo
\IfFileExists{theme-assets/\datasiglogofile}{\datasiglogotrue}{\datasiglogofalse}
%% Width reserved beside frame title: both logos when DataSig is present.
\newlength{\headerlogowidth}
\ifdatasiglogo
  \setlength{\headerlogowidth}{\dimexpr\oxfordlogowidth+\datasiglogowidth+3mm\relax}
\else
  \setlength{\headerlogowidth}{\oxfordlogowidth}
\fi

%% Logo row for frame titles, one box so no input newline can break the line.
%% \smash keeps the crest setting header height; lift centres the shorter logo.
\newcommand{\headerlogos}{%
  \ifdatasiglogo
    \smash{\raisebox{\datasiglogolift}{\includegraphics[width=\datasiglogowidth]{\datasiglogofile}}}\hspace{3mm}%
  \fi%
  \includegraphics[width=\oxfordlogowidth]{oxford-logo.png}%
}

\setbeamertemplate{title page}{
  \begin{picture}(0,0)
    \put(-\textmargin, \dimexpr -\paperheight*6/10 \relax){%
      \ifdim\paperwidth>400pt
        \includegraphics[width=\paperwidth]{title-slide-background-wide.png}
      \else
        \includegraphics[width=\paperwidth]{title-slide-background.png}
      \fi
    }
    \put(-\textmargin +7mm, -55pt){%
      \begin{minipage}[b][4.5cm][t]{0.7\textwidth}
        \raggedright
        \color{white}
        \usebeamerfont{title}{\inserttitle\\[0.9cm]}
        \usebeamerfont{subtitle}
        {\insertauthor\\[0.1cm]}
        {\it\insertinstitute\\[0.3cm]}
        {\insertdate}
      \end{minipage}
    }
  \end{picture}
}

\setbeamertemplate{frametitle}{%
  \rlap{%
    \begin{beamercolorbox}[sep=\titlevmargin,left,wd=\dimexpr\fullpagewidth-\titlehmargin*2+\titlevmargin*2\relax]{frametitle}%
      \begin{minipage}{\dimexpr\fullpagewidth-\headerlogowidth-\titlehmargin*3-0.1cm\relax}%
        \strut\insertframetitle\strut\par%
      \end{minipage}%
      \hspace{\titlehmargin}%
      \begin{minipage}{\dimexpr\headerlogowidth+1mm\relax}%
        \vspace*{-4mm}%
        %% One box: a paragraph would break at \hfill and stack the logos.
        \makebox[\linewidth][r]{\headerlogos}%
      \end{minipage}%
    \end{beamercolorbox}%
  }%
  \vspace{\dimexpr-\baselineskip+1ex\relax}%
  \noindent\rlap{\hspace{-\textmargin}\hspace{\titlehmargin}\rule{\dimexpr\fullpagewidth-\titlehmargin*2\relax}{0.4pt}}%
  \vspace{-0.6ex}%
}

%% Frame number only. Running title, author and date add nothing to a short talk.
\setbeamertemplate{footline}{%
  \hfill{\usebeamercolor[fg]{structure}\tiny\insertframenumber}\hspace*{5mm}%
  \vspace*{2mm}%
}
